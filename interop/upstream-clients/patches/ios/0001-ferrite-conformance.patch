diff --git a/submodules/TelegramCore/Sources/FerriteConformanceConfig.swift b/submodules/TelegramCore/Sources/FerriteConformanceConfig.swift
new file mode 100644
index 0000000000000000000000000000000000000000..6eae3cb7868ad5472d23dbdd503c4e9bd4a4fbb3
--- /dev/null
+++ b/submodules/TelegramCore/Sources/FerriteConformanceConfig.swift
@@ -0,0 +1,108 @@
+import Foundation
+import MtProtoKit
+import SwiftSignalKit
+import TelegramApi
+
+public struct FerriteConformanceConfig {
+    public let host: String
+    public let port: UInt16
+    public let bridgePort: UInt16
+    public let runToken: String
+    public let instanceId: String
+    public let phone: String
+    public let firstName: String
+    public let lastName: String
+    public let peers: [String]
+    public let apiId: Int32
+    public let apiHash: String
+
+    public static var current: FerriteConformanceConfig? {
+        #if targetEnvironment(simulator)
+        let values = ProcessInfo.processInfo.environment
+        guard values["FERRITE_CONFORMANCE"] == "1" else {
+            return nil
+        }
+        guard values["FERRITE_HOST"] == "127.0.0.1" else {
+            return nil
+        }
+        guard let port = checkedPort(values["FERRITE_PORT"]),
+              let bridgePort = checkedPort(values["FERRITE_BRIDGE_PORT"]),
+              port != bridgePort else {
+            return nil
+        }
+        guard let runToken = values["FERRITE_RUN_TOKEN"],
+              runToken.utf8.count == 32,
+              runToken.utf8.allSatisfy({ byte in
+                  return (byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)
+              }) else {
+            return nil
+        }
+        guard let instanceId = checkedIdentifier(values["FERRITE_INSTANCE_ID"]),
+              let phone = checkedPhone(values["FERRITE_PHONE"]),
+              let apiIdValue = values["FERRITE_API_ID"],
+              let apiId = Int32(apiIdValue),
+              apiId > 0,
+              let apiHash = values["FERRITE_API_HASH"],
+              apiHash.utf8.count == 32,
+              apiHash.utf8.allSatisfy({ byte in
+                  return (byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)
+              }) else {
+            return nil
+        }
+        let peers = (values["FERRITE_PEERS"] ?? "")
+            .split(separator: ",")
+            .compactMap { checkedPhone(String($0)) }
+        let requestedPeers = (values["FERRITE_PEERS"] ?? "")
+            .split(separator: ",")
+        guard peers.count == requestedPeers.count,
+              !peers.contains(phone) else {
+            return nil
+        }
+        return FerriteConformanceConfig(
+            host: "127.0.0.1",
+            port: port,
+            bridgePort: bridgePort,
+            runToken: runToken,
+            instanceId: instanceId,
+            phone: phone,
+            firstName: values["FERRITE_FIRST_NAME"] ?? instanceId,
+            lastName: values["FERRITE_LAST_NAME"] ?? "",
+            peers: peers,
+            apiId: apiId,
+            apiHash: apiHash
+        )
+        #else
+        return nil
+        #endif
+    }
+
+    private static func checkedPort(_ value: String?) -> UInt16? {
+        guard let value, let port = UInt16(value), port > 0 else {
+            return nil
+        }
+        return port
+    }
+
+    private static func checkedIdentifier(_ value: String?) -> String? {
+        guard let value, !value.isEmpty, value.utf8.count <= 64,
+              value.utf8.allSatisfy({ byte in
+                  return (byte >= 48 && byte <= 57)
+                      || (byte >= 65 && byte <= 90)
+                      || (byte >= 97 && byte <= 122)
+                      || byte == 45
+              }) else {
+            return nil
+        }
+        return value
+    }
+
+    private static func checkedPhone(_ value: String?) -> String? {
+        guard let value, value.utf8.count >= 2, value.utf8.count <= 20,
+              value.utf8.first == 43,
+              value.utf8.dropFirst().allSatisfy({ $0 >= 48 && $0 <= 57 }) else {
+            return nil
+        }
+        return value
+    }
+}
+
