diff --git a/submodules/TelegramUI/Sources/FerriteConformanceController.swift b/submodules/TelegramUI/Sources/FerriteConformanceController.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a89eb594d5bb1dbefa9b71c99fba771c89489e0b
--- /dev/null
+++ b/submodules/TelegramUI/Sources/FerriteConformanceController.swift
@@ -0,0 +1,512 @@
+import Foundation
+import Network
+import AccountContext
+import Postbox
+import SwiftSignalKit
+import TelegramCore
+import UIKit
+
+private enum FerriteConformanceProvisioningState: String {
+    case starting = "STARTING"
+    case awaitingCode = "AWAITING_CODE"
+    case authorizing = "AUTHORIZING"
+    case importingContacts = "IMPORTING_CONTACTS"
+    case ready = "READY"
+    case failed = "FAILED"
+}
+
+final class FerriteConformanceController {
+    private let config: FerriteConformanceConfig
+    private let context: SharedAccountContextImpl
+    private let queue = DispatchQueue(label: "org.ferrite.provisioning.ios")
+    private let disposables = DisposableSet()
+    private var listener: NWListener?
+    private var provisioningState: FerriteConformanceProvisioningState = .starting
+    private var provisioningHistory: [FerriteConformanceProvisioningState] = [.starting]
+    private var provisioningFailure: String?
+    private var provisioningStage: String = "created"
+    private var requestedAuthorizationCode = false
+    private var unauthorizedAccount: UnauthorizedAccount?
+    private var account: Account?
+    private var accountContext: AccountContext?
+    private var contactsDeadline: Double = 0.0
+
+    init(config: FerriteConformanceConfig, context: SharedAccountContextImpl) {
+        self.config = config
+        self.context = context
+    }
+
+    deinit {
+        self.listener?.cancel()
+        self.disposables.dispose()
+    }
+
+    func start() {
+        self.startListener()
+        self.startProvisioning()
+    }
+
+    private func startListener() {
+        let parameters = NWParameters.tcp
+        parameters.requiredLocalEndpoint = .hostPort(
+            host: NWEndpoint.Host("127.0.0.1"),
+            port: NWEndpoint.Port(rawValue: self.config.bridgePort)!
+        )
+        do {
+            let listener = try NWListener(using: parameters)
+            self.listener = listener
+            listener.newConnectionHandler = { [weak self] connection in
+                self?.handle(connection: connection)
+            }
+            listener.stateUpdateHandler = { [weak self] state in
+                if case let .failed(error) = state {
+                    self?.fail("provisioning listener failed: \(error)")
+                }
+            }
+            listener.start(queue: self.queue)
+        } catch {
+            self.fail("provisioning listener could not start: \(error)")
+        }
+    }
+
+    private func handle(connection: NWConnection) {
+        connection.start(queue: self.queue)
+        self.receive(connection: connection, buffer: Data())
+    }
+
+    private func receive(connection: NWConnection, buffer: Data) {
+        connection.receive(minimumIncompleteLength: 1, maximumLength: 65536) { [weak self] data, _, complete, error in
+            guard let self else {
+                connection.cancel()
+                return
+            }
+            var updated = buffer
+            if let data {
+                updated.append(data)
+            }
+            if updated.count > 65536 {
+                self.send(connection: connection, value: self.errorResponse("request exceeds 65536 bytes"))
+                return
+            }
+            if let newline = updated.firstIndex(of: 10) {
+                let requestData = updated[..<newline]
+                guard updated[updated.index(after: newline)...].allSatisfy({ $0 == 10 || $0 == 13 }) else {
+                    self.send(connection: connection, value: self.errorResponse("one request is allowed per connection"))
+                    return
+                }
+                self.dispatch(data: Data(requestData)) { value in
+                    self.queue.async {
+                        self.send(connection: connection, value: value)
+                    }
+                }
+            } else if complete || error != nil {
+                self.send(connection: connection, value: self.errorResponse("bridge closed before a complete request"))
+            } else {
+                self.receive(connection: connection, buffer: updated)
+            }
+        }
+    }
+
+    private func send(connection: NWConnection, value: [String: Any]) {
+        var response = value
+        response["run_token"] = self.config.runToken
+        guard JSONSerialization.isValidJSONObject(response),
+              var data = try? JSONSerialization.data(withJSONObject: response) else {
+            connection.cancel()
+            return
+        }
+        data.append(10)
+        connection.send(
+            content: data,
+            contentContext: .defaultMessage,
+            isComplete: true,
+            completion: .contentProcessed { _ in connection.cancel() }
+        )
+    }
+
+    private func dispatch(data: Data, completion: @escaping ([String: Any]) -> Void) {
+        guard let value = try? JSONSerialization.jsonObject(with: data),
+              let request = value as? [String: Any] else {
+            completion(self.errorResponse("request is not a JSON object"))
+            return
+        }
+        guard request["run_token"] as? String == self.config.runToken else {
+            completion(self.errorResponse("run token rejected"))
+            return
+        }
+        guard let type = request["type"] as? String else {
+            completion(self.errorResponse("request type is missing"))
+            return
+        }
+        DispatchQueue.main.async { [weak self] in
+            guard let self else {
+                completion(["ok": false, "error": "provisioning endpoint stopped"])
+                return
+            }
+            switch type {
+            case "status":
+                self.status(completion: completion)
+            case "deliver-code":
+                guard let code = request["code"] as? String,
+                      !code.isEmpty,
+                      code.utf8.count <= 32 else {
+                    completion(self.errorResponse("authorization code is invalid"))
+                    return
+                }
+                self.deliver(code: code, completion: completion)
+            default:
+                completion(self.errorResponse("unknown provisioning command: \(type)"))
+            }
+        }
+    }
+
+    private func errorResponse(_ message: String) -> [String: Any] {
+        return ["ok": false, "error": message]
+    }
+
+    private func successResponse(_ values: [String: Any] = [:]) -> [String: Any] {
+        var response = values
+        response["ok"] = true
+        return response
+    }
+
+    private func startProvisioning() {
+        self.provisioningStage = "awaiting-active-contexts"
+        self.disposables.add((self.context.activeAccountContexts
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { [weak self] primary, _, currentAuth in
+            guard let self else {
+                return
+            }
+            if let primary, primary.account.testingEnvironment {
+                self.provisioningStage = "primary-test-account"
+                self.accountContext = primary
+                self.beginContactImport(account: primary.account)
+            } else if let currentAuth, currentAuth.testingEnvironment {
+                self.provisioningStage = "current-test-auth"
+                self.requestAuthorizationCode(account: currentAuth)
+            } else {
+                self.provisioningStage = "begin-new-auth"
+                    + "(primary=\(primary != nil),primaryTest=\(primary?.account.testingEnvironment ?? false)"
+                    + ",auth=\(currentAuth != nil),authTest=\(currentAuth?.testingEnvironment ?? false))"
+                self.context.beginNewAuth(testingEnvironment: true)
+                self.awaitUnauthorizedAccount()
+            }
+        }))
+    }
+
+    private func awaitUnauthorizedAccount() {
+        self.disposables.add((self.context.activeAccountContexts
+        |> deliverOnMainQueue).start(next: { [weak self] _, _, currentAuth in
+            guard let self else {
+                return
+            }
+            self.provisioningStage = "unauthorized-account"
+                + "(present=\(currentAuth != nil),test=\(currentAuth?.testingEnvironment ?? false))"
+            guard let currentAuth, currentAuth.testingEnvironment,
+                  !self.requestedAuthorizationCode else {
+                return
+            }
+            self.requestedAuthorizationCode = true
+            self.provisioningStage = "requesting-code"
+            self.requestAuthorizationCode(account: currentAuth)
+        }))
+    }
+
+    private func requestAuthorizationCode(account: UnauthorizedAccount) {
+        self.unauthorizedAccount = account
+        self.disposables.add((sendAuthorizationCode(
+            accountManager: self.context.accountManager,
+            account: account,
+            phoneNumber: self.config.phone,
+            apiId: self.config.apiId,
+            apiHash: self.config.apiHash,
+            pushNotificationConfiguration: nil,
+            firebaseSecretStream: .never(),
+            syncContacts: false,
+            disableAuthTokens: true,
+            forcedPasswordSetupNotice: { _ in nil }
+        )
+        |> deliverOnMainQueue).start(next: { [weak self] result in
+            guard let self else {
+                return
+            }
+            switch result {
+            case let .sentCode(account):
+                self.unauthorizedAccount = account
+                self.setProvisioningState(.awaitingCode)
+            case .loggedIn:
+                self.awaitAuthorizedAccount()
+            }
+        }, error: { [weak self] error in
+            self?.fail("sendAuthorizationCode failed: \(error)")
+        }))
+    }
+
+    private func deliver(code: String, completion: @escaping ([String: Any]) -> Void) {
+        guard self.provisioningState == .awaitingCode,
+              let account = self.unauthorizedAccount else {
+            completion(self.errorResponse("application is not awaiting an authorization code"))
+            return
+        }
+        self.setProvisioningState(.authorizing)
+        self.disposables.add((authorizeWithCode(
+            accountManager: self.context.accountManager,
+            account: account,
+            code: .phoneCode(code),
+            termsOfService: nil,
+            forcedPasswordSetupNotice: { _ in nil }
+        )
+        |> deliverOnMainQueue).start(next: { [weak self] result in
+            guard let self else {
+                return
+            }
+            switch result {
+            case .loggedIn:
+                completion(self.successResponse(["accepted": true]))
+                self.awaitAuthorizedAccount()
+            case let .signUp(data):
+                self.beginSignUp(account: account, data: data, completion: completion)
+            }
+        }, error: { [weak self] error in
+            guard let self else {
+                return
+            }
+            self.fail("authorizeWithCode failed: \(error)")
+            completion(self.errorResponse("authorization code was rejected"))
+        }))
+    }
+
+    private func beginSignUp(
+        account: UnauthorizedAccount,
+        data: AuthorizationSignUpData,
+        completion: @escaping ([String: Any]) -> Void
+    ) {
+        self.disposables.add((TelegramCore.beginSignUp(account: account, data: data)
+        |> deliverOnMainQueue).start(completed: { [weak self] in
+            guard let self else {
+                return
+            }
+            self.disposables.add((signUpWithName(
+                accountManager: self.context.accountManager,
+                account: account,
+                firstName: self.config.firstName,
+                lastName: self.config.lastName,
+                avatarData: nil,
+                avatarVideo: nil,
+                videoStartTimestamp: nil,
+                disableJoinNotifications: true,
+                forcedPasswordSetupNotice: { _ in nil }
+            )
+            |> deliverOnMainQueue).start(error: { [weak self] error in
+                guard let self else {
+                    return
+                }
+                self.fail("signUpWithName failed: \(error)")
+                completion(self.errorResponse("authorization sign-up failed"))
+            }, completed: { [weak self] in
+                guard let self else {
+                    return
+                }
+                completion(self.successResponse(["accepted": true, "signed_up": true]))
+                self.awaitAuthorizedAccount()
+            }))
+        }))
+    }
+
+    private func awaitAuthorizedAccount() {
+        self.disposables.add((self.context.activeAccountContexts
+        |> filter { primary, _, _ in primary?.account.testingEnvironment == true }
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { [weak self] primary, _, _ in
+            guard let self, let primary else {
+                return
+            }
+            self.accountContext = primary
+            self.beginContactImport(account: primary.account)
+        }))
+    }
+
+    private func beginContactImport(account: Account) {
+        self.account = account
+        self.setProvisioningState(.importingContacts)
+        self.contactsDeadline = Date().timeIntervalSince1970 + 480.0
+        self.provisioningStage = "awaiting-self-peer"
+        account.viewTracker.forceUpdateCachedPeerData(peerId: account.peerId)
+        self.awaitSelfPeer()
+    }
+
+    private func awaitSelfPeer() {
+        guard let account = self.account else {
+            self.fail("authorized account disappeared before self peer sync")
+            return
+        }
+        self.disposables.add((account.postbox.transaction { transaction -> Bool in
+            transaction.getPeer(account.peerId) != nil
+        }
+        |> deliverOnMainQueue).start(next: { [weak self] stored in
+            guard let self else {
+                return
+            }
+            if stored {
+                self.provisioningStage = "importing-contacts"
+                self.attemptContactImport()
+            } else if Date().timeIntervalSince1970 >= self.contactsDeadline {
+                self.fail("the application never stored its own peer")
+            } else {
+                account.viewTracker.forceUpdateCachedPeerData(peerId: account.peerId)
+                DispatchQueue.main.asyncAfter(deadline: .now() + 2.0) { [weak self] in
+                    self?.awaitSelfPeer()
+                }
+            }
+        }))
+    }
+
+    private func attemptContactImport() {
+        guard let account = self.account else {
+            self.fail("authorized account disappeared during contact import")
+            return
+        }
+        if self.config.peers.isEmpty {
+            self.setProvisioningState(.ready)
+            return
+        }
+        let engine = TelegramEngine(account: account)
+        let signals = self.config.peers.map { phone in
+            engine.contacts.importContact(firstName: phone, lastName: "", phoneNumber: phone)
+        }
+        self.disposables.add((combineLatest(queue: .mainQueue(), signals)
+        |> deliverOnMainQueue).start(next: { [weak self] _ in
+            self?.verifyImportedContacts()
+        }))
+    }
+
+    private func verifyImportedContacts() {
+        guard let account = self.account else {
+            self.fail("authorized account disappeared before contact verification")
+            return
+        }
+        self.disposables.add((account.postbox.transaction { transaction -> Set<String> in
+            Set(transaction.getContactPeerIds().compactMap { peerId -> String? in
+                (transaction.getPeer(peerId) as? TelegramUser)?.phone.map {
+                    FerriteConformanceController.canonicalPhone($0)
+                }
+            })
+        }
+        |> deliverOnMainQueue).start(next: { [weak self] phones in
+            guard let self else {
+                return
+            }
+            if Set(self.config.peers).isSubset(of: phones) {
+                self.setProvisioningState(.ready)
+            } else if Date().timeIntervalSince1970 >= self.contactsDeadline {
+                self.fail("Postbox does not contain every configured peer contact")
+            } else {
+                DispatchQueue.main.asyncAfter(deadline: .now() + 2.0) { [weak self] in
+                    self?.attemptContactImport()
+                }
+            }
+        }))
+    }
+
+    private static func canonicalPhone(_ value: String) -> String {
+        return "+" + value.filter { $0.isNumber }
+    }
+
+    private func setProvisioningState(_ value: FerriteConformanceProvisioningState) {
+        self.provisioningState = value
+        if self.provisioningHistory.last != value {
+            self.provisioningHistory.append(value)
+        }
+    }
+
+    private func fail(_ message: String) {
+        if Thread.isMainThread {
+            self.provisioningFailure = message
+            self.setProvisioningState(.failed)
+        } else {
+            DispatchQueue.main.async { [weak self] in
+                self?.provisioningFailure = message
+                self?.setProvisioningState(.failed)
+            }
+        }
+    }
+
+    private func status(completion: @escaping ([String: Any]) -> Void) {
+        guard let account = self.account else {
+            var value: [String: Any] = [
+                "instance_id": self.config.instanceId,
+                "phone": self.config.phone,
+                "provisioning": self.provisioningState.rawValue,
+                "provisioning_history": self.provisioningHistory.map(\.rawValue),
+                "stage": self.provisioningStage,
+                "client_activated": false,
+                "user_id": 0,
+                "layer": Serialization().currentLayer(),
+                "contacts": [],
+            ]
+            if let failure = self.provisioningFailure {
+                value["provisioning_failure"] = failure
+            }
+            completion(self.successResponse(value))
+            return
+        }
+        let selfPeerStored = account.postbox.transaction { transaction -> Bool in
+            transaction.getPeer(account.peerId) != nil
+        }
+        let contacts = account.postbox.transaction { transaction -> [[String: Any]] in
+            transaction.getContactPeerIds().compactMap { peerId -> [String: Any]? in
+                guard let user = transaction.getPeer(peerId) as? TelegramUser else {
+                    return nil
+                }
+                return [
+                    "user_id": user.id.id._internalGetInt64Value(),
+                    "phone": user.phone.map { FerriteConformanceController.canonicalPhone($0) } ?? "",
+                    "first_name": user.firstName ?? "",
+                    "last_name": user.lastName ?? "",
+                ]
+            }
+        }
+        self.disposables.add((combineLatest(
+            contacts,
+            account.network.connectionStatus |> take(1),
+            selfPeerStored
+        )
+        |> deliverOnMainQueue).start(next: { [weak self] contacts, connectionStatus, selfPeerStored in
+            guard let self else {
+                return
+            }
+            let connection: String
+            switch connectionStatus {
+            case .waitingForNetwork:
+                connection = "waiting-for-network"
+            case .connecting:
+                connection = "connecting"
+            case .updating:
+                connection = "updating"
+            case .online:
+                connection = "online"
+            }
+            var value: [String: Any] = [
+                "instance_id": self.config.instanceId,
+                "phone": self.config.phone,
+                "provisioning": self.provisioningState.rawValue,
+                "provisioning_history": self.provisioningHistory.map(\.rawValue),
+                "stage": self.provisioningStage,
+                "client_activated": true,
+                "user_id": account.peerId.id._internalGetInt64Value(),
+                "layer": Serialization().currentLayer(),
+                "datacenter_id": account.network.datacenterId,
+                "server_time": Int64(account.network.globalTime),
+                "connection_state": connection == "waiting-for-network" ? 2 : 3,
+                "connection_status": connection,
+                "self_peer_stored": selfPeerStored,
+                "contacts": contacts,
+            ]
+            if let failure = self.provisioningFailure {
+                value["provisioning_failure"] = failure
+            }
+            completion(self.successResponse(value))
+        }))
+    }
+}
