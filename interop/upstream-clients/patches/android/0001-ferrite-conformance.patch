@@ -0,0 +1,52 @@
+package org.telegram.conformance;
+
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+/** Blocking wrapper over the application's own production request path. */
+public final class ConformanceRpc {
+
+    public static final int UNAUTHORIZED_FLAGS =
+            ConnectionsManager.RequestFlagEnableUnauthorized
+                    | ConnectionsManager.RequestFlagFailOnServerErrors
+                    | ConnectionsManager.RequestFlagWithoutLogin;
+
+    public static final int AUTHORIZED_FLAGS = ConnectionsManager.RequestFlagFailOnServerErrors;
+
+    public static final class RpcError extends Exception {
+        public final int code;
+        public final String text;
+
+        RpcError(TLRPC.TL_error error) {
+            super(error.code + ": " + error.text);
+            code = error.code;
+            text = error.text;
+        }
+    }
+
+    private ConformanceRpc() {
+    }
+
+    public static TLObject invoke(int account, TLObject request, int flags, long timeoutMs)
+            throws RpcError, InterruptedException {
+        final Object[] slot = new Object[2];
+        final CountDownLatch latch = new CountDownLatch(1);
+        ConnectionsManager.getInstance(account).sendRequest(request, (response, error) -> {
+            slot[0] = response;
+            slot[1] = error;
+            latch.countDown();
+        }, flags);
+        if (!latch.await(timeoutMs, TimeUnit.MILLISECONDS)) {
+            throw new IllegalStateException(
+                    "ferrite conformance request timed out: " + request.getClass().getSimpleName());
+        }
+        if (slot[1] != null) {
+            throw new RpcError((TLRPC.TL_error) slot[1]);
+        }
+        return (TLObject) slot[0];
+    }
+}
