+bool ConnectionsManager::readConformanceEndpoint(std::string &host, uint32_t &port) {
+    static const char *fileName = "ferrite-conformance.properties";
+    std::string candidates[2] = {currentConfigPath + fileName,
+                                 currentConfigPath + "../" + fileName};
+    for (const std::string &candidate : candidates) {
+        std::ifstream stream(candidate);
+        if (!stream.is_open()) {
+            continue;
+        }
+        std::string line;
+        std::string readHost;
+        uint32_t readPort = 0;
+        while (std::getline(stream, line)) {
+            size_t separator = line.find('=');
+            if (separator == std::string::npos) {
+                continue;
+            }
+            std::string key = line.substr(0, separator);
+            std::string value = line.substr(separator + 1);
+            while (!value.empty() && (value.back() == '\r' || value.back() == '\n' || value.back() == ' ')) {
+                value.pop_back();
+            }
+            if (key == "ferrite.host") {
+                readHost = value;
+            } else if (key == "ferrite.port") {
+                readPort = (uint32_t) std::strtoul(value.c_str(), nullptr, 10);
+            }
+        }
+        if (!readHost.empty() && readPort > 0 && readPort <= 65535) {
+            host = readHost;
+            port = readPort;
+            return true;
+        }
+    }
+    return false;
+}
