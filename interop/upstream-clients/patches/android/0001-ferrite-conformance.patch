+package org.telegram.conformance;
+
+import android.util.Log;
+
+/** Tags conformance output so the launcher can slice it out of logcat. */
+public final class ConformanceLog {
+
+    public static final String TAG = "FerriteConformance";
+
+    private ConformanceLog() {
+    }
+
+    public static void info(String message) {
+        Log.i(TAG, message);
+    }
+
+    public static void error(String message, Throwable error) {
+        Log.e(TAG, message, error);
+    }
+}
