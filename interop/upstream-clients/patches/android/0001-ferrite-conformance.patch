@@ -0,0 +1,295 @@
+package org.telegram.conformance;
+
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.LaunchActivity;
+import org.telegram.ui.LoginActivity;
+
+/**
+ * Drives the application's own login screens with the input a user would type.
+ * Nothing here builds a request, reads a response or writes account state; the
+ * only witness of success is the application's own {@link UserConfig}.
+ */
+final class ConformanceLogin {
+
+    private static final long POLL_MS = 250L;
+
+    private static volatile LoginActivity fragment;
+
+    private static volatile LoginActivity additional;
+
+    private ConformanceLogin() {
+    }
+
+    /**
+     * Adopts the login fragment the application restored, or presents one the
+     * way the intro screen's own button does.
+     */
+    static void present(long timeoutMs) throws InterruptedException {
+        LaunchActivity activity = awaitLauncher(timeoutMs);
+        final LoginActivity[] slot = new LoginActivity[1];
+        ConformanceProvisioner.runOnUiThreadAndWait(() -> {
+            for (BaseFragment presented : activity.getActionBarLayout().getFragmentStack()) {
+                if (presented instanceof LoginActivity) {
+                    slot[0] = (LoginActivity) presented;
+                    return;
+                }
+            }
+            LoginActivity login = new LoginActivity();
+            activity.presentFragment(login, true, false);
+            slot[0] = login;
+        });
+        fragment = slot[0];
+    }
+
+    static void submitPhone(String digits) throws InterruptedException {
+        LoginActivity login = current();
+        ConformanceProvisioner.runOnUiThreadAndWait(
+                () -> login.ferriteConformanceSubmitPhone(digits));
+    }
+
+    static void submitCode(String code) throws InterruptedException {
+        LoginActivity login = current();
+        ConformanceProvisioner.runOnUiThreadAndWait(() -> login.ferriteConformanceSubmitCode(code));
+    }
+
+    static void submitName(String firstName, String lastName) throws InterruptedException {
+        LoginActivity login = current();
+        ConformanceProvisioner.runOnUiThreadAndWait(
+                () -> login.ferriteConformanceSubmitName(firstName, lastName));
+    }
+
+    static boolean awaitPhonePage(long timeoutMs) throws InterruptedException {
+        return await(timeoutMs, () -> current().ferriteConformanceOnPhonePage());
+    }
+
+    static boolean awaitCodePage(long timeoutMs) throws InterruptedException {
+        return await(timeoutMs, () -> current().ferriteConformanceOnCodePage());
+    }
+
+    /**
+     * The register page appears only for a number Ferrite has no user for, and
+     * the sign-in path leaves it unvisited, so this returns as soon as either the
+     * page arrives or the application reports itself signed in.
+     */
+    static boolean awaitRegisterPageOrAuthorized(long timeoutMs) throws InterruptedException {
+        return await(timeoutMs,
+                () -> isAuthorized() || current().ferriteConformanceOnRegisterPage());
+    }
+
+    static boolean awaitAuthorized(long timeoutMs) throws InterruptedException {
+        return await(timeoutMs, ConformanceLogin::isAuthorized);
+    }
+
+    /** The application's own witness that it is signed in. */
+    static boolean isAuthorized() {
+        UserConfig config = UserConfig.getInstance(ConformanceProvisioner.ACCOUNT);
+        return config.isClientActivated() && config.getCurrentUser() != null;
+    }
+
+    static TLRPC.User currentUser() {
+        return UserConfig.getInstance(ConformanceProvisioner.ACCOUNT).getCurrentUser();
+    }
+
+    static int currentPage() {
+        LoginActivity login = fragment;
+        return login == null ? -1 : login.ferriteConformanceCurrentView();
+    }
+
+    /**
+     * Presents a login screen for the first account slot the application has
+     * left, which is what its own drawer does when a user adds an account. The
+     * slot the provisioned user occupies is never touched, so the rows that
+     * come after this one still find the application signed in as itself.
+     */
+    static int presentAdditional(long timeoutMs) throws InterruptedException {
+        LaunchActivity activity = awaitLauncher(timeoutMs);
+        final int[] account = new int[]{-1};
+        final LoginActivity[] slot = new LoginActivity[1];
+        ConformanceProvisioner.runOnUiThreadAndWait(() -> {
+            for (int index = 0; index < UserConfig.MAX_ACCOUNT_COUNT; index++) {
+                if (!UserConfig.getInstance(index).isClientActivated()) {
+                    account[0] = index;
+                    break;
+                }
+            }
+            if (account[0] < 0) {
+                return;
+            }
+            LoginActivity login = new LoginActivity(account[0]);
+            activity.presentFragment(login);
+            slot[0] = login;
+        });
+        if (slot[0] == null) {
+            throw new IllegalStateException(
+                    "the application has no free account slot to sign in with");
+        }
+        additional = slot[0];
+        return account[0];
+    }
+
+    static void submitAdditionalPhone(String digits) throws InterruptedException {
+        LoginActivity login = additional();
+        ConformanceProvisioner.runOnUiThreadAndWait(
+                () -> login.ferriteConformanceSubmitPhone(digits));
+    }
+
+    static void submitAdditionalCode(String code) throws InterruptedException {
+        LoginActivity login = additional();
+        ConformanceProvisioner.runOnUiThreadAndWait(
+                () -> login.ferriteConformanceSubmitCode(code));
+    }
+
+    static void submitPassword(String password) throws InterruptedException {
+        LoginActivity login = additional();
+        ConformanceProvisioner.runOnUiThreadAndWait(
+                () -> login.ferriteConformanceSubmitPassword(password));
+    }
+
+    static void forgotPassword() throws InterruptedException {
+        LoginActivity login = additional();
+        ConformanceProvisioner.runOnUiThreadAndWait(
+                login::ferriteConformanceForgotPassword);
+    }
+
+    static void submitRecoveryCode(String code) throws InterruptedException {
+        LoginActivity login = additional();
+        ConformanceProvisioner.runOnUiThreadAndWait(
+                () -> login.ferriteConformanceSubmitRecoveryCode(code));
+    }
+
+    static void submitNewPassword(String password) throws InterruptedException {
+        LoginActivity login = additional();
+        ConformanceProvisioner.runOnUiThreadAndWait(
+                () -> login.ferriteConformanceSubmitNewPassword(password));
+    }
+
+    static void submitPasswordHint(String hint) throws InterruptedException {
+        LoginActivity login = additional();
+        ConformanceProvisioner.runOnUiThreadAndWait(
+                () -> login.ferriteConformanceSubmitPasswordHint(hint));
+    }
+
+    /** Presses the alert's own continue button, once it is on screen. */
+    static boolean awaitConfirmedDialog(long timeoutMs) throws InterruptedException {
+        LoginActivity login = additional();
+        return await(timeoutMs, login::ferriteConformanceConfirmDialog);
+    }
+
+    static boolean awaitAdditionalPhonePage(long timeoutMs) throws InterruptedException {
+        return await(timeoutMs, () -> additional().ferriteConformanceOnPhonePage());
+    }
+
+    static boolean awaitAdditionalCodePage(long timeoutMs) throws InterruptedException {
+        return await(timeoutMs, () -> additional().ferriteConformanceOnCodePage());
+    }
+
+    static boolean awaitPasswordPage(long timeoutMs) throws InterruptedException {
+        return await(timeoutMs, () -> additional().ferriteConformanceOnPasswordPage());
+    }
+
+    static boolean awaitRecoverPage(long timeoutMs) throws InterruptedException {
+        return await(timeoutMs, () -> additional().ferriteConformanceOnRecoverPage());
+    }
+
+    static boolean awaitNewPasswordPage(long timeoutMs) throws InterruptedException {
+        return await(timeoutMs, () -> additional().ferriteConformanceOnNewPasswordPage());
+    }
+
+    static boolean awaitPasswordHintPage(long timeoutMs) throws InterruptedException {
+        return await(timeoutMs, () -> additional().ferriteConformanceOnPasswordHintPage());
+    }
+
+    static boolean awaitAdditionalAuthorized(int account, long timeoutMs)
+            throws InterruptedException {
+        return await(timeoutMs, () -> isAuthorized(account));
+    }
+
+    static boolean isAuthorized(int account) {
+        UserConfig config = UserConfig.getInstance(account);
+        return config.isClientActivated() && config.getCurrentUser() != null;
+    }
+
+    static TLRPC.User currentUser(int account) {
+        return UserConfig.getInstance(account).getCurrentUser();
+    }
+
+    static int additionalPage() {
+        LoginActivity login = additional;
+        return login == null ? -1 : login.ferriteConformanceCurrentView();
+    }
+
+    /**
+     * Signs the extra slot out through the application's own logout, so the
+     * next row finds exactly the accounts provisioning left behind.
+     */
+    static void logOutAdditional(int account) throws InterruptedException {
+        LoginActivity login = additional;
+        ConformanceProvisioner.runOnUiThreadAndWait(() -> {
+            if (UserConfig.getInstance(account).isClientActivated()) {
+                MessagesController.getInstance(account).performLogout(1);
+            } else if (login != null) {
+                // A login that never signed in leaves its screen on top of the
+                // provisioned account, where the next row would drive it.
+                login.finishFragment();
+            }
+        });
+        additional = null;
+    }
+
+    private static LoginActivity additional() {
+        LoginActivity login = additional;
+        if (login == null) {
+            throw new IllegalStateException(
+                    "no additional login fragment has been presented");
+        }
+        return login;
+    }
+
+    private static LoginActivity current() {
+        LoginActivity login = fragment;
+        if (login == null) {
+            throw new IllegalStateException("the login fragment has not been presented");
+        }
+        return login;
+    }
+
+    private interface Condition {
+        boolean met();
+    }
+
+    /** Page and account state belong to the main thread, so they are read there. */
+    private static boolean await(long timeoutMs, Condition condition) throws InterruptedException {
+        long deadline = System.currentTimeMillis() + timeoutMs;
+        while (System.currentTimeMillis() < deadline) {
+            final boolean[] met = new boolean[1];
+            ConformanceProvisioner.runOnUiThreadAndWait(() -> met[0] = condition.met());
+            if (met[0]) {
+                return true;
+            }
+            Thread.sleep(POLL_MS);
+        }
+        return false;
+    }
+
+    private static LaunchActivity awaitLauncher(long timeoutMs) throws InterruptedException {
+        long deadline = System.currentTimeMillis() + timeoutMs;
+        while (System.currentTimeMillis() < deadline) {
+            final LaunchActivity[] slot = new LaunchActivity[1];
+            ConformanceProvisioner.runOnUiThreadAndWait(() -> {
+                LaunchActivity activity = LaunchActivity.instance;
+                if (activity != null && !activity.isFinishing()
+                        && !activity.getActionBarLayout().getFragmentStack().isEmpty()) {
+                    slot[0] = activity;
+                }
+            });
+            if (slot[0] != null) {
+                return slot[0];
+            }
+            Thread.sleep(POLL_MS);
+        }
+        throw new IllegalStateException("the application's launcher never presented a screen");
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/conformance/ConformanceProvisioner.java b/TMessagesProj/src/main/java/org/telegram/conformance/ConformanceProvisioner.java
new file mode 100644
index 0000000000000000000000000000000000000000..312ab895cfcc321c983406c993dc88c30cbcaa90
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/conformance/ConformanceProvisioner.java
@@ -0,0 +1,267 @@
+package org.telegram.conformance;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ContactsController;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Signs the instance in with its assigned phone number and puts every peer
+ * instance of the same run into its contact list. Both are driven through the
+ * application's own login screens and contact sync; this class supplies input
+ * and reads the application's own state back.
+ */
+public final class ConformanceProvisioner {
+
+    public static final int ACCOUNT = 0;
+
+    private static final long REQUEST_TIMEOUT_MS = 60_000L;
+    private static final long CONTACT_TIMEOUT_MS = 480_000L;
+    private static final long CODE_TIMEOUT_MS = 180_000L;
+    private static final long LAUNCHER_TIMEOUT_MS = 120_000L;
+    private static final long PAGE_TIMEOUT_MS = 60_000L;
+
+    public enum State {
+        PENDING,
+        AUTHORIZING,
+        AWAITING_CODE,
+        IMPORTING_CONTACTS,
+        READY,
+        FAILED
+    }
+
+    private static final java.util.concurrent.BlockingQueue<String> deliveredCodes =
+            new java.util.concurrent.ArrayBlockingQueue<>(1);
+    private static volatile State state = State.PENDING;
+    private static final java.util.List<State> stateHistory = new ArrayList<>();
+    private static volatile String failure;
+    private static volatile long userId;
+    private static final Map<String, Long> peerUserIds = new LinkedHashMap<>();
+
+    private ConformanceProvisioner() {
+    }
+
+    static {
+        stateHistory.add(State.PENDING);
+    }
+
+    public static State state() {
+        return state;
+    }
+
+    public static synchronized java.util.List<State> stateHistory() {
+        return new ArrayList<>(stateHistory);
+    }
+
+    private static synchronized void setState(State value) {
+        state = value;
+        if (stateHistory.isEmpty() || stateHistory.get(stateHistory.size() - 1) != value) {
+            stateHistory.add(value);
+        }
+    }
+
+    public static String failure() {
+        return failure;
+    }
+
+    public static long userId() {
+        return userId;
+    }
+
+    public static synchronized Map<String, Long> peerUserIds() {
+        return new LinkedHashMap<>(peerUserIds);
+    }
+
+    public static void start() {
+        Thread thread = new Thread(ConformanceProvisioner::run, "ferrite-conformance-provisioner");
+        thread.setDaemon(true);
+        thread.start();
+    }
+
+    private static void run() {
+        ConformanceConfig config = ConformanceConfig.get();
+        try {
+            setState(State.AUTHORIZING);
+            TLRPC.User user = authorize(config);
+            userId = user.id;
+            ConformanceLog.info("authorized as " + user.id + " (" + config.phone + ")");
+            setState(State.IMPORTING_CONTACTS);
+            importPeers(config);
+            setState(State.READY);
+            ConformanceLog.info("provisioned with " + peerUserIds.size() + " peer contacts");
+        } catch (Throwable error) {
+            failure = error.toString();
+            setState(State.FAILED);
+            ConformanceLog.error("provisioning failed", error);
+        }
+    }
+
+    /**
+     * Signs in by driving the application's own login screens. Every request on
+     * the wire is built and sent by the application, and the only success witness
+     * is the {@link UserConfig} its own {@code onAuthSuccess} writes.
+     */
+    private static TLRPC.User authorize(ConformanceConfig config) throws Exception {
+        UserConfig userConfig = UserConfig.getInstance(ACCOUNT);
+        TLRPC.User existing = userConfig.getCurrentUser();
+        if (userConfig.isClientActivated() && existing != null
+                && samePhone(existing.phone, config.phone)) {
+            return existing;
+        }
+
+        ConformanceLogin.present(LAUNCHER_TIMEOUT_MS);
+        if (!ConformanceLogin.awaitPhonePage(PAGE_TIMEOUT_MS)) {
+            throw new IllegalStateException("the login flow never reached its phone page; it is on "
+                    + ConformanceLogin.currentPage());
+        }
+        ConformanceLogin.submitPhone(config.phone.replace("+", ""));
+
+        if (!ConformanceLogin.awaitCodePage(PAGE_TIMEOUT_MS)) {
+            throw new IllegalStateException("the login flow never reached a code page; it is on "
+                    + ConformanceLogin.currentPage());
+        }
+        ConformanceLogin.submitCode(verificationCode(config));
+
+        if (!ConformanceLogin.awaitRegisterPageOrAuthorized(PAGE_TIMEOUT_MS)) {
+            throw new IllegalStateException(
+                    "the login flow neither signed in nor offered registration; it is on "
+                            + ConformanceLogin.currentPage());
+        }
+        if (!ConformanceLogin.isAuthorized()) {
+            ConformanceLogin.submitName(config.firstName, config.lastName);
+        }
+        if (!ConformanceLogin.awaitAuthorized(REQUEST_TIMEOUT_MS)) {
+            throw new IllegalStateException("the application never reported itself signed in");
+        }
+
+        TLRPC.User user = ConformanceLogin.currentUser();
+        if (!samePhone(user.phone, config.phone)) {
+            throw new IllegalStateException("the application signed in as " + user.phone
+                    + " instead of " + config.phone);
+        }
+        return user;
+    }
+
+    /**
+     * A deployment that issues a random code has to hand it to the instance the
+     * same way an SMS would. A configured code is used as-is, so a deployment
+     * with a fixed development code needs no channel at all.
+     */
+    private static String verificationCode(ConformanceConfig config) throws InterruptedException {
+        if (config.verificationCode != null) {
+            return config.verificationCode;
+        }
+        deliveredCodes.clear();
+        setState(State.AWAITING_CODE);
+        String code = deliveredCodes.poll(CODE_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+        if (code == null) {
+            throw new IllegalStateException(
+                    "no verification code was delivered to the instance");
+        }
+        setState(State.AUTHORIZING);
+        return code;
+    }
+
+    public static boolean deliverCode(String code) {
+        return deliveredCodes.offer(code);
+    }
+
+    /**
+     * The peers are already in the device's own phone book, so the application
+     * imports them with its own contact sync. Nothing here builds
+     * {@code contacts.importContacts} or writes a user into the app's storage.
+     *
+     * Peers of the same run sign in independently, and one of them may still be
+     * booting a device on the other platform, so the application's own import is
+     * repeated until Ferrite resolves every one of them. Both waits share the one
+     * budget, which stays under the launcher's own, so the instance reports why it
+     * gave up before the launcher stops waiting for it.
+     */
+    private static void importPeers(ConformanceConfig config) throws Exception {
+        if (config.peers.isEmpty()) {
+            return;
+        }
+        long deadline = System.currentTimeMillis() + CONTACT_TIMEOUT_MS;
+        forceImportContacts();
+        awaitContacts(config, deadline);
+    }
+
+    private static void forceImportContacts() {
+        ContactsController.getInstance(ACCOUNT).forceImportContacts();
+    }
+
+    private static void awaitContacts(ConformanceConfig config, long deadline) throws Exception {
+        while (System.currentTimeMillis() < deadline) {
+            Map<String, Long> resolved = new LinkedHashMap<>();
+            runOnUiThreadAndWait(() -> resolved.putAll(localContacts(config)));
+            if (resolved.size() == config.peers.size()) {
+                synchronized (ConformanceProvisioner.class) {
+                    peerUserIds.clear();
+                    peerUserIds.putAll(resolved);
+                }
+                return;
+            }
+            Thread.sleep(2000L);
+            forceImportContacts();
+            runOnUiThreadAndWait(() ->
+                    ContactsController.getInstance(ACCOUNT).loadContacts(false, 0));
+        }
+        java.util.List<String> observed = new ArrayList<>();
+        runOnUiThreadAndWait(() -> observed.addAll(localContacts(config).keySet()));
+        throw new IllegalStateException(
+                "peer contacts never reached the application's own contact list; observed "
+                        + observed);
+    }
+
+    /** Reads the peers the application's own contact list holds. */
+    private static Map<String, Long> localContacts(ConformanceConfig config) {
+        Map<String, Long> resolved = new LinkedHashMap<>();
+        for (TLRPC.TL_contact contact : ContactsController.getInstance(ACCOUNT).contacts) {
+            TLRPC.User user = MessagesController.getInstance(ACCOUNT).getUser(contact.user_id);
+            if (user == null) {
+                continue;
+            }
+            for (String peer : config.peers) {
+                if (samePhone(user.phone, peer)) {
+                    resolved.put(peer, user.id);
+                }
+            }
+        }
+        return resolved;
+    }
+
+    static boolean samePhone(String left, String right) {
+        return left != null && right != null
+                && left.replace("+", "").equals(right.replace("+", ""));
+    }
+
+    static void runOnUiThreadAndWait(Runnable action) throws InterruptedException {
+        final CountDownLatch latch = new CountDownLatch(1);
+        final Throwable[] slot = new Throwable[1];
+        AndroidUtilities.runOnUIThread(() -> {
+            try {
+                action.run();
+            } catch (Throwable error) {
+                slot[0] = error;
+            } finally {
+                latch.countDown();
+            }
+        });
+        if (!latch.await(REQUEST_TIMEOUT_MS, TimeUnit.MILLISECONDS)) {
+            throw new IllegalStateException("ferrite conformance main-thread step timed out");
+        }
+        if (slot[0] != null) {
+            // The cause is named here because the bridge reports toString(): a
+            // bare wrapper says only that something on the main thread failed.
+            throw new IllegalStateException(
+                    "ferrite conformance main-thread step failed: " + slot[0], slot[0]);
+        }
+    }
+}
