@@ -1683,6 +1683,134 @@ public class LoginActivity extends BaseFragment implements NotificationCenter.No
         needFinishActivity(afterSignup, res.setup_password_required, res.otherwise_relogin_days);
     }

+    /* Ferrite conformance: supplies the input a user would type and hands control
+       straight back to the login flow. These build no request and apply no result;
+       confirmedNumber pre-answers a device-local dialog the way the stored
+       askAboutContacts preference pre-answers another one. */
+    public int ferriteConformanceCurrentView() {
+        return currentViewNum;
+    }
+
+    public boolean ferriteConformanceOnPhonePage() {
+        return currentViewNum == VIEW_PHONE_INPUT && views[VIEW_PHONE_INPUT] != null;
+    }
+
+    public boolean ferriteConformanceOnCodePage() {
+        return views[currentViewNum] instanceof LoginActivitySmsView;
+    }
+
+    public boolean ferriteConformanceOnRegisterPage() {
+        return currentViewNum == VIEW_REGISTER && views[VIEW_REGISTER] != null;
+    }
+
+    /* The whole number goes into the country field, which is what a paste does:
+       the field's own watcher splits the country code off and moves the rest into
+       the phone field, so nothing outside the application decides where it ends. */
+    public void ferriteConformanceSubmitPhone(String digits) {
+        PhoneView view = (PhoneView) views[VIEW_PHONE_INPUT];
+        // The screen may already hold the device's own SIM number, which a user
+        // would type over rather than append to.
+        view.phoneField.setText("");
+        view.codeField.setText(digits);
+        String entered = PhoneFormat.stripExceptNumbers(
+                "" + view.codeField.getText() + view.phoneField.getText());
+        if (!entered.equals(digits)) {
+            throw new IllegalStateException(
+                    "the login screen holds " + entered + " instead of " + digits);
+        }
+        view.confirmedNumber = true;
+        view.onNextPressed(null);
+    }
+
