+package org.telegram.conformance;
+
+/** Starts the conformance bridge and provisioning once the application is up. */
+public final class ConformanceRuntime {
+
+    private static boolean started;
+
+    private ConformanceRuntime() {
+    }
+
+    public static synchronized void start() {
+        if (started || !ConformanceConfig.isEnabled()) {
+            return;
+        }
+        started = true;
+        ConformanceBridge.start();
+        ConformanceProvisioner.start();
+    }
+}
