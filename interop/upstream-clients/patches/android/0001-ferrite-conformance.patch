diff --git a/TMessagesProj/src/main/java/org/telegram/conformance/ConformanceBridge.java b/TMessagesProj/src/main/java/org/telegram/conformance/ConformanceBridge.java
new file mode 100644
index 0000000000000000000000000000000000000000..6061f6f800c55542899ce72fffd59b4c3a6f66a2
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/conformance/ConformanceBridge.java
@@ -0,0 +1,157 @@
+package org.telegram.conformance;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.ContactsController;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.net.InetAddress;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+
+/** Loopback-only provisioning status and verification-code endpoint. */
+public final class ConformanceBridge {
+
+    private static final int ACCOUNT = ConformanceProvisioner.ACCOUNT;
+    private static Thread thread;
+
+    private ConformanceBridge() {
+    }
+
+    public static synchronized void start() {
+        if (thread != null) {
+            return;
+        }
+        thread = new Thread(ConformanceBridge::serve, "ferrite-provisioning-bridge");
+        thread.setDaemon(true);
+        thread.start();
+    }
+
+    private static void serve() {
+        ConformanceConfig config = ConformanceConfig.get();
+        try (ServerSocket server = new ServerSocket(
+                config.bridgePort, 16, InetAddress.getByName("127.0.0.1"))) {
+            ConformanceLog.info("provisioning bridge listening on 127.0.0.1:"
+                    + config.bridgePort);
+            while (!Thread.currentThread().isInterrupted()) {
+                Socket socket = server.accept();
+                Thread client = new Thread(
+                        () -> handle(socket, config), "ferrite-provisioning-command");
+                client.setDaemon(true);
+                client.start();
+            }
+        } catch (Throwable error) {
+            ConformanceLog.error("provisioning bridge stopped", error);
+        }
+    }
+
+    private static void handle(Socket socket, ConformanceConfig config) {
+        try (Socket open = socket;
+             BufferedReader reader = new BufferedReader(
+                     new InputStreamReader(open.getInputStream(), StandardCharsets.UTF_8));
+             BufferedWriter writer = new BufferedWriter(
+                     new OutputStreamWriter(open.getOutputStream(), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                JSONObject response;
+                try {
+                    JSONObject request = new JSONObject(line);
+                    if (!config.runToken.equals(request.optString("run_token"))) {
+                        throw new IllegalStateException("run token rejected");
+                    }
+                    response = dispatch(request, config);
+                    response.put("ok", true);
+                } catch (Throwable error) {
+                    response = new JSONObject();
+                    response.put("ok", false);
+                    response.put("error", String.valueOf(error));
+                }
+                response.put("run_token", config.runToken);
+                writer.write(response.toString());
+                writer.write("\n");
+                writer.flush();
+            }
+        } catch (Throwable error) {
+            ConformanceLog.error("provisioning bridge connection failed", error);
+        }
+    }
+
+    private static JSONObject dispatch(JSONObject request, ConformanceConfig config)
+            throws Exception {
+        String type = request.getString("type");
+        switch (type) {
+            case "status":
+                return status(config);
+            case "deliver-code":
+                return deliverCode(request);
+            default:
+                throw new IllegalArgumentException(
+                        "unknown provisioning command: " + type);
+        }
+    }
+
+    private static JSONObject status(ConformanceConfig config) throws Exception {
+        JSONObject value = new JSONObject();
+        value.put("instance_id", config.instanceId);
+        value.put("phone", config.phone);
+        value.put("provisioning", ConformanceProvisioner.state().name());
+        JSONArray history = new JSONArray();
+        for (ConformanceProvisioner.State observed : ConformanceProvisioner.stateHistory()) {
+            history.put(observed.name());
+        }
+        value.put("provisioning_history", history);
+        String failure = ConformanceProvisioner.failure();
+        if (failure != null) {
+            value.put("provisioning_failure", failure);
+        }
+        value.put("user_id", ConformanceProvisioner.userId());
+        value.put("login_page", ConformanceLogin.currentPage());
+        value.put("layer", TLRPC.LAYER);
+        ConnectionsManager manager = ConnectionsManager.getInstance(ACCOUNT);
+        value.put("connection_state", manager.getConnectionState());
+        value.put("datacenter_id", manager.getCurrentDatacenterId());
+        value.put("server_time", manager.getCurrentTime());
+        value.put("client_activated", UserConfig.getInstance(ACCOUNT).isClientActivated());
+
+        JSONObject peers = new JSONObject();
+        for (Map.Entry<String, Long> entry : ConformanceProvisioner.peerUserIds().entrySet()) {
+            peers.put(entry.getKey(), entry.getValue());
+        }
+        value.put("peer_user_ids", peers);
+
+        JSONArray contacts = new JSONArray();
+        for (TLRPC.TL_contact contact : ContactsController.getInstance(ACCOUNT).contacts) {
+            TLRPC.User user = MessagesController.getInstance(ACCOUNT).getUser(contact.user_id);
+            JSONObject entry = new JSONObject();
+            entry.put("user_id", contact.user_id);
+            entry.put("phone", user == null ? JSONObject.NULL : user.phone);
+            contacts.put(entry);
+        }
+        value.put("contacts", contacts);
+        return value;
+    }
+
+    private static JSONObject deliverCode(JSONObject request) throws Exception {
+        String code = request.getString("code");
+        if (ConformanceProvisioner.state() != ConformanceProvisioner.State.AWAITING_CODE) {
+            throw new IllegalStateException(
+                    "the instance is not waiting for a verification code (state "
+                            + ConformanceProvisioner.state() + ")");
+        }
+        if (!ConformanceProvisioner.deliverCode(code)) {
+            throw new IllegalStateException("a verification code is already queued");
+        }
+        JSONObject value = new JSONObject();
+        value.put("delivered", true);
+        return value;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/conformance/ConformanceConfig.java b/TMessagesProj/src/main/java/org/telegram/conformance/ConformanceConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..b2cc709673ee85c2effdcc2cf43edc4a1405b1f5
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/conformance/ConformanceConfig.java
@@ -0,0 +1,124 @@
+package org.telegram.conformance;
+
+import android.content.Context;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Properties;
+
+/**
+ * Launch configuration for a Ferrite conformance instance.
+ *
+ * The launcher writes {@code ferrite-conformance.properties} into the instance's
+ * external files directory. {@link #install(Context)} copies it into the internal
+ * files directory before any networking starts, so tgnet reads the same file from
+ * its own config path and the application layer reads it from here.
+ */
+public final class ConformanceConfig {
+
+    public static final String FILE_NAME = "ferrite-conformance.properties";
+
+    private static ConformanceConfig instance;
+    private static boolean installed;
+
+    public final String host;
+    public final int port;
+    public final int apiId;
+    public final String apiHash;
+    public final String instanceId;
+    public final String phone;
+    public final String firstName;
+    public final String lastName;
+    public final String verificationCode;
+    public final List<String> peers;
+    public final int bridgePort;
+    public final String runToken;
+
+    private ConformanceConfig(Properties properties) {
+        host = required(properties, "ferrite.host");
+        port = requiredInt(properties, "ferrite.port");
+        apiId = requiredInt(properties, "ferrite.api_id");
+        apiHash = required(properties, "ferrite.api_hash");
+        instanceId = required(properties, "instance.id");
+        phone = required(properties, "instance.phone");
+        firstName = properties.getProperty("instance.first_name", instanceId);
+        lastName = properties.getProperty("instance.last_name", "");
+        String code = properties.getProperty("auth.code", "").trim();
+        verificationCode = code.isEmpty() ? null : code;
+        bridgePort = requiredInt(properties, "bridge.port");
+        runToken = required(properties, "bridge.token");
+        List<String> parsed = new ArrayList<>();
+        for (String value : properties.getProperty("instance.peers", "").split(",")) {
+            String trimmed = value.trim();
+            if (!trimmed.isEmpty()) {
+                parsed.add(trimmed);
+            }
+        }
+        peers = Collections.unmodifiableList(parsed);
+    }
+
+    private static String required(Properties properties, String key) {
+        String value = properties.getProperty(key);
+        if (value == null || value.trim().isEmpty()) {
+            throw new IllegalStateException("ferrite conformance config is missing " + key);
+        }
+        return value.trim();
+    }
+
+    private static int requiredInt(Properties properties, String key) {
+        return Integer.parseInt(required(properties, key));
+    }
+
+    /**
+     * Copies the launcher's configuration into the internal files directory and
+     * parses it. A missing file leaves the application on its stock code paths.
+     */
+    public static synchronized void install(Context context) {
+        if (installed) {
+            return;
+        }
+        installed = true;
+        try {
+            File internal = new File(context.getFilesDir(), FILE_NAME);
+            File external = new File(context.getExternalFilesDir(null), FILE_NAME);
+            if (external.isFile()) {
+                copy(external, internal);
+            }
+            if (!internal.isFile()) {
+                return;
+            }
+            Properties properties = new Properties();
+            try (InputStream stream = new FileInputStream(internal)) {
+                properties.load(stream);
+            }
+            instance = new ConformanceConfig(properties);
+        } catch (Throwable error) {
+            throw new IllegalStateException("ferrite conformance config is unusable", error);
+        }
+    }
+
+    private static void copy(File from, File to) throws Exception {
+        try (InputStream source = new FileInputStream(from);
+             OutputStream target = new FileOutputStream(to)) {
+            byte[] buffer = new byte[8192];
+            int read;
+            while ((read = source.read(buffer)) > 0) {
+                target.write(buffer, 0, read);
+            }
+        }
+    }
+
+    public static synchronized ConformanceConfig get() {
+        return instance;
+    }
+
+    public static synchronized boolean isEnabled() {
+        return instance != null;
+    }
+}
