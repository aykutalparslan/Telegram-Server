@@ -1,5 +1,26 @@
 cmake_minimum_required(VERSION 3.16)

+# The GNU binutils archiver shipped with this NDK does not run on current macOS
+# hosts. The LLVM archiver from the same NDK writes identical archives.
+if(EXISTS "${ANDROID_TOOLCHAIN_ROOT}/bin/llvm-ar")
+    set(CMAKE_AR "${ANDROID_TOOLCHAIN_ROOT}/bin/llvm-ar" CACHE FILEPATH "" FORCE)
+    set(CMAKE_C_COMPILER_AR "${ANDROID_TOOLCHAIN_ROOT}/bin/llvm-ar" CACHE FILEPATH "" FORCE)
+    set(CMAKE_CXX_COMPILER_AR "${ANDROID_TOOLCHAIN_ROOT}/bin/llvm-ar" CACHE FILEPATH "" FORCE)
+    set(CMAKE_RANLIB "${ANDROID_TOOLCHAIN_ROOT}/bin/llvm-ranlib" CACHE FILEPATH "" FORCE)
+    set(CMAKE_C_COMPILER_RANLIB "${ANDROID_TOOLCHAIN_ROOT}/bin/llvm-ranlib" CACHE FILEPATH "" FORCE)
+    set(CMAKE_CXX_COMPILER_RANLIB "${ANDROID_TOOLCHAIN_ROOT}/bin/llvm-ranlib" CACHE FILEPATH "" FORCE)
+endif()
+
+# Absolute checkout paths otherwise reach the shipped library through __FILE__
+# diagnostics and through the debug info the linker hashes into its build id.
+# This NDK's Clang predates -ffile-prefix-map, so __FILE__ falls back to the
+# builtin base name. Clang records the resolved working directory, which a
+# prefix map keyed on CMake's own spelling of it would miss, so the compilation
+# directory is set outright.
+add_compile_options("-fdebug-prefix-map=${CMAKE_HOME_DIRECTORY}=/src"
+    "SHELL:-Xclang -fdebug-compilation-dir -Xclang /build"
+    -Wno-builtin-macro-redefined -D__FILE__=__FILE_NAME__)
+
 set(CMAKE_CXX_FLAGS "-std=c++14 -DANDROID -g")
 set(CMAKE_C_FLAGS "-w -std=c11 -DANDROID -D_LARGEFILE_SOURCE=1 -g -Wno-error=implicit-function-declaration")
 set(CMAKE_ASM_FLAGS "${CFLAGS} -x assembler-with-cpp")
@@ -128,6 +149,11 @@ add_library(breakpad STATIC
         third_party/breakpad/src/common/linux/safe_readlink.cc)
 set_target_properties(breakpad PROPERTIES ANDROID_ARM_MODE arm)
 set_property(SOURCE third_party/breakpad/src/common/android/breakpad_getcontext.S PROPERTY LANGUAGE C)
+# This source assembles instead of compiling, and the assembler takes the
+# compilation directory only from its own option. Targets built with
+# -fno-integrated-as cannot carry it, so it stays on the one source that needs it.
+set_property(SOURCE third_party/breakpad/src/common/android/breakpad_getcontext.S
+        APPEND PROPERTY COMPILE_OPTIONS -Wa,-fdebug-compilation-dir,/build)
 target_include_directories(breakpad PUBLIC
         third_party/breakpad/src/common/android/include
         third_party/breakpad/src)
